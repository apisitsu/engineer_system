# --- AI & Tool Configurations ---
# .claude/* (not .claude/) — git will not descend into an excluded dir,
# so the negations below only work if the contents are excluded, not the dir itself.
.claude/*
!.claude/rules/
!.claude/rules/**
!.claude/skills/
!.claude/skills/**

claude-skills/
# --- Temporary & Local Files ---
tmp/

./apps/uploads

git_sync_mtc.ps1
# --- MTC design-standard PDFs & calc-block extraction (reference only; no code reads bytes) ---
# TEMPLATE_B.xlsx + 20260202_Tooling_Excel_List.xlsm ARE read at runtime — keep those.
apps/ENG-Backend/api/engineer/mtc/doc/RE*.pdf
apps/ENG-Backend/api/engineer/mtc/doc/RM*.pdf
apps/ENG-Backend/api/engineer/mtc/doc/EDRE*.pdf
apps/ENG-Backend/api/engineer/mtc/doc/tooling_calc_blocks/**/*.pdf
apps/ENG-Backend/api/engineer/mtc/doc/tooling_calc_blocks/**/*.xlsx
